# ============================================================================
# Darjeeling Momo — ROOT environment (shared defaults)
# ============================================================================
# The app starts with NO .env beyond what `pnpm setup:local` generates from
# `supabase status`. Every key below is OPTIONAL at build time: a service runs
# in REAL mode when its keys are present, and in LOCAL PLACEHOLDER mode when
# they are missing. See INTEGRATIONS.md to switch a placeholder to real.
#
# Copy to `.env` only if you want to override the auto-generated local values.
# Per-app examples: apps/web/.env.example, apps/mobile/.env.example,
# supabase/functions/.env.example
# ----------------------------------------------------------------------------

# Integration mode: "local" (default) forces placeholders; "auto" uses real
# services wherever keys are present; "production" refuses to start with any
# placeholder (mock payments / dev sign-in). Leave as "auto" normally.
INTEGRATIONS_MODE=auto

# Working business name — the ONLY place the name lives. Rename here.
NEXT_PUBLIC_APP_NAME=Darjeeling Momo

# --- Supabase (local values are written by `pnpm setup:local`) --------------
# REAL mode: paste the hosted project's URL + keys (see INTEGRATIONS.md §1).
# SUPABASE_URL=                      # PLACEHOLDER — add when you have hosted Supabase
# SUPABASE_ANON_KEY=                 # PLACEHOLDER — add when you have hosted Supabase
# SUPABASE_SERVICE_ROLE_KEY=         # PLACEHOLDER — SERVER ONLY, never ship to a client

# --- Stripe (payments) ------------------------------------------------------
# STRIPE_SECRET_KEY=                 # PLACEHOLDER — add when you have Stripe
# STRIPE_WEBHOOK_SECRET=             # PLACEHOLDER — add when you have Stripe
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=  # PLACEHOLDER — add when you have Stripe

# --- Google OAuth (handled by Supabase Auth; configure in dashboard) --------
# No client-side key needed; see INTEGRATIONS.md §2.

# --- Expo / EAS push --------------------------------------------------------
# EXPO_PUBLIC_EAS_PROJECT_ID=        # PLACEHOLDER — add when you have an EAS project
