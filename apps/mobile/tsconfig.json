{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowJs": true,
    "types": [
      "react",
      "expo"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "app",
    "src",
    "app.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
