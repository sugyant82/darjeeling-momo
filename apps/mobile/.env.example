# ============================================================================
# apps/mobile environment. `pnpm setup:local` generates apps/mobile/.env for you.
# All EXPO_PUBLIC_* values are embedded in the app bundle (not secret).
# The Supabase URL uses your machine's LAN IP so Expo Go on a phone can reach it.
# ============================================================================

EXPO_PUBLIC_INTEGRATIONS_MODE=auto
EXPO_PUBLIC_APP_NAME=Darjeeling Momo
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_WEB_ORIGIN=http://localhost:3000

# --- Switch services to real (see INTEGRATIONS.md) ---
# EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=true       # PLACEHOLDER — add when you have Google OAuth
# EXPO_PUBLIC_APPLE_AUTH_ENABLED=true        # PLACEHOLDER — add when you have Apple sign-in (iOS)
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...  # PLACEHOLDER — add when you have Stripe (needs a dev build)
# EXPO_PUBLIC_EAS_PROJECT_ID=...             # PLACEHOLDER — add when you have an EAS project (enables push)
