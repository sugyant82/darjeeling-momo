# ============================================================================
# apps/web environment. `pnpm setup:local` generates apps/web/.env.local for you
# from `supabase status`; you only edit this when switching services to real.
# NEXT_PUBLIC_* are exposed to the browser. Everything else is server-only.
# ============================================================================

INTEGRATIONS_MODE=auto
NEXT_PUBLIC_APP_NAME=Darjeeling Momo

# --- Supabase (auto-filled locally) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google sign-in (set true once the Supabase Google provider is configured) ---
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true      # PLACEHOLDER — add when you have Google OAuth

# --- Stripe (web Payment Element) ---
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...   # PLACEHOLDER — add when you have Stripe
